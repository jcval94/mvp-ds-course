{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jcval94/mvp-ds-course/schemas/mission.schema.json",
  "title": "Misión del curso (missions/<id>/mission.yaml)",
  "description": "Una misión une un caso histórico de decisión con los conceptos que se desbloquean al resolverlo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "status", "access", "decision", "case", "concepts"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^m[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 3 },
    "status": { "enum": ["draft", "review", "ready", "published"] },
    "access": { "enum": ["public", "premium"] },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question"],
      "properties": {
        "question": { "type": "string", "minLength": 10 },
        "naive_answer": { "type": "string" },
        "ingenious_move": { "type": "string" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "level": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["number"],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 14 }
      }
    },
    "kit": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^kits/[a-z0-9-]+/[a-z0-9_-]+\\.ipynb$" }
      }
    },
    "video": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "url"],
      "properties": {
        "provider": { "enum": ["youtube", "external"] },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "side_quest": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["capsula"],
      "properties": {
        "capsula": { "type": "string", "pattern": "^[0-9]{2}_[a-z0-9_]+$" }
      }
    },
    "notes": { "type": "string" }
  }
}
