{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jcval94/mvp-ds-course/schemas/case.schema.json",
  "title": "Caso histórico de decisión (casos/cases.jsonl y casos/staging/*.json)",
  "description": "Afirmaciones verificadas separadas de incertidumbres y mitos. Un caso 'approved' exige al menos dos fuentes y una afirmación verificada.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "decision_question", "status", "access", "concepts", "verified_claims", "uncertainties", "myths_to_avoid", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 3 },
    "decision_question": { "type": "string", "minLength": 10 },
    "naive_answer": { "type": "string" },
    "ingenious_move": { "type": "string" },
    "status": { "enum": ["candidate", "verified", "approved"] },
    "access": { "enum": ["public", "premium"] },
    "supersedes": { "type": "string" },
    "concepts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "level_hint": { "type": "integer", "minimum": 1, "maximum": 13 },
    "verified_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "sources"],
        "properties": {
          "claim": { "type": "string", "minLength": 10 },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://" } }
        }
      }
    },
    "uncertainties": { "type": "array", "items": { "type": "string", "minLength": 5 } },
    "myths_to_avoid": { "type": "array", "items": { "type": "string", "minLength": 5 } },
    "sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^https://" } },
    "dataset": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "path", "provenance", "license", "sha256"],
      "properties": {
        "kind": { "enum": ["real", "reconstructed", "synthetic"] },
        "path": { "type": "string", "pattern": "^casos/data/[a-z0-9-]+/" },
        "provenance": { "type": "string", "minLength": 5 },
        "license": { "type": "string", "minLength": 2 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "story_bridge": { "type": "string" },
    "analogy_limits": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["verified", "approved"] } } },
      "then": {
        "properties": {
          "verified_claims": { "minItems": 1 },
          "sources": { "minItems": 2 },
          "uncertainties": { "minItems": 1 },
          "concepts": { "minItems": 1 }
        }
      }
    }
  ]
}
